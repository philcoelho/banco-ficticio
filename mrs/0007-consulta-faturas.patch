+import { describe, expect, it } from "vitest";
+import { consultarFaturasDoCliente } from "../src/faturas/consulta.ts";
+import type { Fatura } from "../src/faturas/tipos.ts";
+import type { Db } from "../src/infra/db.ts";
+
+const fatura: Fatura = {
+  id: "F-1",
+  documento: "12345678909",
+  cliente: "Cliente Teste",
+  valor: 10_000,
+  vencimento: "2026-11-10",
+  status: "aberta",
+};
+
+const dbFalso: Db = {
+  all: async <T>() => [fatura] as T[],
+  run: async () => {},
+};
+
+describe("consultarFaturasDoCliente", () => {
+  it("retorna as faturas do cliente", async () => {
+    const resultado = await consultarFaturasDoCliente(
+      dbFalso,
+      { usuarioId: "u-1", documento: "12345678909" },
+      "12345678909",
+    );
+
+    expect(resultado).toHaveLength(1);
+    expect(resultado[0]?.id).toBe("F-1");
+  });
+});
