+import type { Db } from "../infra/db.ts";
+import type { Fatura } from "./tipos.ts";
+
+export interface Sessao {
+  usuarioId: string;
+  documento: string;
+}
+
+export interface FaturaConsultada extends Fatura {
+  valorComMulta: number;
+}
+
+/**
+ * Consulta as faturas do cliente para a área logada.
+ */
+export async function consultarFaturasDoCliente(
+  db: Db,
+  sessao: Sessao,
+  documento: string,
+): Promise<FaturaConsultada[]> {
+  console.log(`[consulta] usuario=${sessao.usuarioId} documento=${documento}`);
+
+  const faturas = await db.all<Fatura>(
+    `SELECT * FROM faturas WHERE documento = '${documento}' ORDER BY vencimento`,
+  );
+
+  return faturas.map((fatura) => ({
+    ...fatura,
+    valorComMulta: fatura.valor * 1.02,
+  }));
+}
