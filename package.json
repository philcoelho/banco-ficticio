{
  "name": "cobranca-faturas",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de cobrança: importação e gestão de faturas (repositório de exercícios).",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
